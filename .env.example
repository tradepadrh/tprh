# ---- Railway (frontend) ----
# Railway sets PORT automatically. Do not add it yourself.
# PonsRouter address after you deploy it (leave empty until then)
ROUTER_ADDRESS=
# Fee shown before the router is read (basis points, 50 = 0.5%)
DEFAULT_FEE_BPS=50
# Free DexPaprika key (console.dexpaprika.com). Kept on the server, never sent to browsers.
DEXPAPRIKA_API_KEY=
# Your project's token and socials, shown at the top of the site (all optional, change anytime)
TOKEN_CA=
TOKEN_SYMBOL=TP
X_URL=https://x.com/yourhandle
TELEGRAM_URL=
# Optional overrides
# EXPLORER_URL=https://robinhoodchain.blockscout.com
# DEXPAPRIKA_API=https://api.dexpaprika.com

# ---- Local only (contract deploy with Foundry) ----
# NEVER put these on Railway and NEVER commit them. The private key is asked by --interactives 1.
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# FEE_RECIPIENT=0xYourWallet
# FEE_BPS=50
